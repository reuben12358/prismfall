# Prismfall Cutscenes - offline self-test (NOT loaded by the game: the file name
# has no ".rb" in it on purpose, PluginManager loads every *.rb* file).
#
#   ruby selftest/harness.ruby_stub                 run the whole suite
#   ruby selftest/harness.ruby_stub --render ID --at 1,2.5,7 --out /tmp/frames [--assets] [key=value ...]
#
# It fakes the RGSS classes (Sprite/Bitmap/Viewport/Graphics/Input/...) strictly
# enough to catch non-integer pixel coordinates, use-after-dispose and leaks,
# and can software-render frames to PNG (needs ImageMagick `convert`).
require "set"
PLUGIN_DIR = File.expand_path("..", __dir__)
GAME_DIR   = File.expand_path("../..", PLUGIN_DIR)
ASSET_DIR  = ENV["PF_ASSETS"] || "/home/claude/ref/ebdx_renovation"
$opt = { :assets => false, :render => false, :fps => 40.0 }
$stats = Hash.new(0)
$live = { :sprite => 0, :bitmap => 0, :viewport => 0 }
$audio = []
$clock = 0.0
$DEBUG_PF = true

class Color
  attr_accessor :red, :green, :blue, :alpha
  def initialize(r = 0, g = 0, b = 0, a = 255); set(r, g, b, a); end
  def set(r, g, b, a = 255)
    [r, g, b, a].each { |v| raise TypeError, "Color component #{v.inspect}" if !v.is_a?(Numeric) }
    @red = r.to_f; @green = g.to_f; @blue = b.to_f; @alpha = a.to_f
    self
  end
  def pack; (@red.round.clamp(0, 255) << 24) | (@green.round.clamp(0, 255) << 16) | (@blue.round.clamp(0, 255) << 8) | @alpha.round.clamp(0, 255); end
end

class Tone
  attr_accessor :red, :green, :blue, :gray
  def initialize(r = 0, g = 0, b = 0, gr = 0); set(r, g, b, gr); end
  def set(r, g, b, gr = 0); @red = r.to_f; @green = g.to_f; @blue = b.to_f; @gray = gr.to_f; self; end
end

class Rect
  attr_accessor :x, :y, :width, :height
  def initialize(x = 0, y = 0, w = 0, h = 0); set(x, y, w, h); end
  def set(x, y, w, h)
    [x, y, w, h].each { |v| raise TypeError, "Rect wants Integers, got #{v.inspect}" if !v.is_a?(Integer) }
    @x = x; @y = y; @width = w; @height = h
    self
  end
end

class Font
  attr_accessor :size, :color, :name, :bold
  def initialize; @size = 27; @color = Color.new(255, 255, 255); @name = "stub"; end
end

class Bitmap
  attr_reader :width, :height, :font, :px
  def initialize(a, b = nil)
    if a.is_a?(String)
      raise "Bitmap: file not found #{a}" if !File.file?(a)
      @width, @height = `identify -format "%w %h" "#{a}"`.split.map(&:to_i)
      @path = a
      @px = `convert "#{a}" -depth 8 rgba:-`.unpack("N*") if $opt[:render]
    else
      raise TypeError, "Bitmap size #{a.inspect}x#{b.inspect}" if !a.is_a?(Integer) || !b.is_a?(Integer) || a <= 0 || b <= 0
      @width = a; @height = b
      @px = Array.new(a * b, 0) if $opt[:render]
    end
    @font = Font.new
    @disposed = false
    $live[:bitmap] += 1
    $stats[:bitmaps] += 1
  end
  def alive!; raise "use of disposed Bitmap" if @disposed; end
  def dispose; return if @disposed; @disposed = true; $live[:bitmap] -= 1; end
  def disposed?; @disposed; end
  def rect; Rect.new(0, 0, @width, @height); end
  def clear; alive!; $stats[:clear] += 1; @px.fill(0) if @px; end
  def fill_rect(*args)
    alive!
    if args.length == 2 then r, c = args; x, y, w, h = r.x, r.y, r.width, r.height
    else x, y, w, h, c = args
    end
    [x, y, w, h].each { |v| raise TypeError, "fill_rect wants Integers, got #{[x, y, w, h].inspect}" if !v.is_a?(Integer) }
    raise TypeError, "fill_rect colour #{c.inspect}" if !c.is_a?(Color)
    $stats[:fill] += 1
    $frame_fills += 1
    return if !@px
    x0 = [x, 0].max; y0 = [y, 0].max; x1 = [x + w, @width].min; y1 = [y + h, @height].min
    return if x1 <= x0 || y1 <= y0
    v = c.pack
    (y0...y1).each { |yy| @px.fill(v, (yy * @width) + x0, x1 - x0) }
  end
  def stretch_blt(dest, src, r, opacity = 255)
    alive!; src.alive!
    raise TypeError, "stretch_blt" if !dest.is_a?(Rect) || !r.is_a?(Rect)
    raise ArgumentError, "stretch_blt source out of range #{[r.x, r.y, r.width, r.height].inspect} of #{src.width}x#{src.height}" if r.x < 0 || r.y < 0 || r.x + r.width > src.width || r.y + r.height > src.height || r.width <= 0
    $stats[:blt] += 1
    return if !@px || !src.px
    dest.height.times do |j|
      sy = r.y + (j * r.height / dest.height); dy = dest.y + j
      next if dy < 0 || dy >= @height
      dest.width.times do |i|
        dx = dest.x + i
        next if dx < 0 || dx >= @width
        p = src.px[(sy * src.width) + r.x + (i * r.width / dest.width)]
        @px[(dy * @width) + dx] = p if (p & 255) > 0
      end
    end
  end
  def blt(x, y, src, r, opacity = 255)
    alive!; src.alive!
    raise TypeError, "blt" if !x.is_a?(Integer) || !y.is_a?(Integer) || !r.is_a?(Rect)
    $stats[:blt] += 1
    return if !@px || !src.px
    r.height.times do |j|
      sy = r.y + j; dy = y + j
      next if sy < 0 || sy >= src.height || dy < 0 || dy >= @height
      r.width.times do |i|
        sx = r.x + i; dx = x + i
        next if sx < 0 || sx >= src.width || dx < 0 || dx >= @width
        p = src.px[(sy * src.width) + sx]
        @px[(dy * @width) + dx] = p if (p & 255) > 0
      end
    end
  end
  def text_size(str); Rect.new(0, 0, (str.to_s.length * @font.size * 0.45).round, @font.size); end
  def draw_text(x, y, w, h, str, align = 0)
    alive!
    [x, y, w, h].each { |v| raise TypeError, "draw_text wants Integers" if !v.is_a?(Integer) }
    $stats[:text] += 1
    return if !@px || str.to_s.strip.empty?
    tw, th, data = Bitmap.render_text(str.to_s, @font.size)
    ox = x + ((align == 1) ? (w - tw) / 2 : ((align == 2) ? w - tw : 0))
    oy = y + ((h - th) / 2)
    col = @font.color.pack & 0xFFFFFF00
    th.times do |j|
      dy = oy + j
      next if dy < 0 || dy >= @height
      tw.times do |i|
        dx = ox + i
        next if dx < 0 || dx >= @width
        a = data[(j * tw) + i] & 255
        @px[(dy * @width) + dx] = col | 255 if a > 110
      end
    end
  end
  def self.render_text(str, size)
    @texts ||= {}
    key = [str, size]
    return @texts[key] if @texts[key]
    tmp = "/tmp/pf_text_#{Process.pid}.rgba"
    safe = str.gsub("\\", "\\\\\\\\").gsub('"', '\"').gsub("%", "%%").gsub("@", "\\@")
    dims = `convert -background none -fill white -font DejaVu-Sans-Bold -pointsize #{(size * 0.62).round} label:"#{safe}" -depth 8 -print "%w %h" rgba:#{tmp} 2>/dev/null`
    w, h = dims.split.map(&:to_i)
    data = (w && h && File.file?(tmp)) ? File.binread(tmp).unpack("N*") : []
    w, h = 1, 1 if data.empty?
    data = [0] if data.empty?
    @texts[key] = [w, h, data]
  end
end

class Viewport
  attr_accessor :z, :color, :tone, :ox, :oy, :visible
  attr_reader :rect, :sprites
  ALL = []
  def initialize(x, y, w, h)
    @rect = Rect.new(x, y, w, h); @z = 0; @color = Color.new(0, 0, 0, 0); @tone = Tone.new; @sprites = []
    @disposed = false; @serial = (ALL.last ? ALL.last.serial + 1 : 0)
    ALL.push(self); $live[:viewport] += 1
  end
  attr_reader :serial
  def dispose
    return if @disposed
    @disposed = true; ALL.delete(self); $live[:viewport] -= 1
    left = @sprites.reject(&:disposed?)
    raise "Viewport disposed with #{left.length} live sprites" if !left.empty?
  end
  def disposed?; @disposed; end
end

class Sprite
  attr_reader :x, :y, :z, :ox, :oy, :bitmap, :viewport, :src_rect, :serial
  attr_accessor :zoom_x, :zoom_y, :angle, :mirror, :color, :tone, :visible, :blend_type
  @@serial = 0
  def initialize(viewport = nil)
    raise "Sprite needs a live viewport" if viewport && viewport.disposed?
    @viewport = viewport; @x = @y = @z = @ox = @oy = 0; @zoom_x = @zoom_y = 1.0; @angle = 0; @mirror = false
    @opacity = 255; @color = Color.new(0, 0, 0, 0); @tone = Tone.new; @visible = true; @blend_type = 0
    @src_rect = Rect.new(0, 0, 0, 0); @disposed = false; @serial = (@@serial += 1)
    viewport.sprites.push(self) if viewport
    $live[:sprite] += 1; $stats[:sprites] += 1
  end
  def int!(v, what); raise TypeError, "Sprite##{what} must be an Integer (pixel grid), got #{v.inspect}" if !v.is_a?(Integer); v; end
  def x=(v); @x = int!(v, :x); end
  def y=(v); @y = int!(v, :y); end
  def z=(v); @z = int!(v, :z); end
  def ox=(v); @ox = int!(v, :ox); end
  def oy=(v); @oy = int!(v, :oy); end
  def opacity; @opacity; end
  def opacity=(v); raise TypeError, "opacity #{v.inspect}" if !v.is_a?(Numeric); @opacity = v.clamp(0, 255); end
  def bitmap=(b)
    raise "disposed bitmap assigned" if b && b.disposed?
    @bitmap = b
    @src_rect = Rect.new(0, 0, b.width, b.height) if b
  end
  def dispose; return if @disposed; @disposed = true; $live[:sprite] -= 1; end
  def disposed?; @disposed; end
end

module Graphics
  def self.width; 512; end
  def self.height; 384; end
  def self.frame_rate; $opt[:fps]; end
  def self.update
    $stats[:frames] += 1
    $max_fills = [$max_fills, $frame_fills].max
    $fill_log.push($frame_fills) if $frame_fills > 0
    $frame_fills = 0
    $on_frame.call if $on_frame
    dt = 1.0 / $opt[:fps]
    dt *= 0.5 + rand if $opt[:jitter]
    dt = 0.5 if $opt[:hitch] && ($stats[:frames] % 97) == 0     # simulated lag spikes
    $clock += dt
  end
end
$max_fills = 0
$frame_fills = 0
$fill_log = []

module System; def self.uptime; $clock; end; end

module Input
  USE = :use; BACK = :back; ACTION = :action
  def self.update; end
  def self.press?(b); $input_press ? $input_press.call(b) : false; end
  def self.trigger?(b); $input_trigger ? $input_trigger.call(b) : false; end
end

def asset(path)
  return nil if !$opt[:assets] || path.nil?
  return path if path.start_with?("/") && File.file?(path)
  [path, path + ".png"].each { |p| f = File.join(ASSET_DIR, p); return f if File.file?(f) }
  nil
end
def pbResolveBitmap(path); asset(path); end
def pbSetSystemFont(bmp); bmp.font.size = 27; end
def _INTL(str, *args); args.each_with_index { |a, i| str = str.gsub("{#{i + 1}}", a.to_s) }; str; end
def echoln(s); $stderr.puts(s) if ENV["PF_VERBOSE"]; ($log ||= []).push(s); end
def pbBGMPlay(n, v = nil, p = nil); $audio.push([:bgm, n, v]); end
def pbBGSPlay(n, v = nil, p = nil); $audio.push([:bgs, n, v]); end
def pbSEPlay(n, v = nil, p = nil);  $audio.push([:se, n, v]); end
def pbMEPlay(n, v = nil, p = nil);  $audio.push([:me, n, v]); end
def pbBGMFade(s = 0.0); $audio.push([:bgm_fade, s]); end
def pbBGSFade(s = 0.0); $audio.push([:bgs_fade, s]); end
MsgWindowStub = Struct.new(:y, :height, :viewport, :z)
$msg_y = 288
# Stand-in for the core pbMessageDisplay: records the text and runs a short frame loop.
def pbMessageDisplay(msgwindow, message, letterbyletter = true, commandProc = nil)
  ($shown ||= []).push(message)
  ($msg_frames || 24).times do
    Graphics.update
    Input.update
    yield if block_given?
  end
  nil
end
def pbMessage(msg, commands = nil, cancel = 0, *rest, &block)
  ($messages ||= []).push(msg)
  pbMessageDisplay(MsgWindowStub.new($msg_y, 96, nil, 0), msg, &block)
  ($menu_choice || 0)
end
