  # Pretend the design/AUDIO.md cues exist so the cue list can be checked.
  def self.audio_exist?(path); $opt[:audio] != false; end
end
class GameSystemStub
  def bgm_memorize; $audio.push([:memorize]); end
  def bgm_restore; $audio.push([:restore]); end
end
$game_system = GameSystemStub.new
$game_player = Struct.new(:character_name).new("trainer_POKEMONTRAINER_Red")

module MenuHandlers
  HANDLERS = {}
  def self.add(menu, id, hash); (HANDLERS[menu] ||= {})[id] = hash; end
end
module EventHandlers
  def self.add(*a); end
end

module GameData
  SpeciesStub = Struct.new(:id, :name, :types)
  TYPES = {}
  # types from the real PBS when present
  ["#{ASSET_DIR}/PBS/pokemon.txt"].each do |f|
    next if !File.file?(f)
    cur = nil
    File.foreach(f, :encoding => "utf-8") do |line|
      if line =~ /^\[(\w+)\]/ then cur = $1.to_sym
      elsif cur && line =~ /^Types\s*=\s*(.+)/ then TYPES[cur] = $1.strip.split(",").map { |t| t.strip.to_sym }
      end
    end
  end
  module Species
    def self.try_get(s); return nil if s.nil?; SpeciesStub.new(s, s.to_s.capitalize, TYPES[s] || [:NORMAL]); end
    def self.front_sprite_filename(s, form = 0, gender = 0, shiny = false, shadow = false)
      asset("Graphics/Pokemon/Front#{shiny ? ' shiny' : ''}/#{s}")
    end
    def self.back_sprite_filename(s, form = 0, gender = 0, shiny = false, shadow = false)
      asset("Graphics/Pokemon/Back#{shiny ? ' shiny' : ''}/#{s}")
    end
    def self.icon_filename(s, form = 0, gender = 0, shiny = false, shadow = false, egg = false)
      asset("Graphics/Pokemon/Icons/#{s}")
    end
    def self.play_cry_from_species(s, form = 0, vol = 90, pitch = 100); $audio.push([:cry, s]); end
  end
  module TrainerType
    def self.front_sprite_filename(t); asset("Graphics/Trainers/#{t}") || asset("Graphics/Trainers/#{$trainer_art[t]}"); end
    def self.charset_filename(t); asset("Graphics/Characters/trainer_#{t}"); end
    def self.exists?(t); true; end
  end
  TrainerStub = Struct.new(:trainer_type, :real_name, :version, :pokemon)
  module Trainer
    DATA = {}
    f = File.join(GAME_DIR, "pbs/trainers.txt")
    if File.file?(f)
      cur = nil
      File.foreach(f, :encoding => "utf-8") do |line|
        if line =~ /^\[(\w+),([^,\]]+)(?:,(\d+))?\]/
          cur = TrainerStub.new($1.to_sym, $2.strip, ($3 || 0).to_i, [])
          DATA[[cur.trainer_type, cur.real_name, cur.version]] = cur
        elsif cur && line =~ /^Pokemon\s*=\s*(\w+),(\d+)/
          cur.pokemon.push({ :species => $1.to_sym, :level => $2.to_i })
        end
      end
    end
    def self.try_get(t, n, v = 0); DATA[[t, n, v]]; end
    def self.exists?(t, n, v = 0); DATA.has_key?([t, n, v]); end
  end
end
$trainer_art = Hash.new("POKEMONTRAINER_Red")

#-------------------------------------------------------------------------------
# Software compositor (render mode)
#-------------------------------------------------------------------------------
def composite
  w = Graphics.width; h = Graphics.height
  out = Array.new(w * h, 0x000000FF)
  Viewport::ALL.sort_by { |v| [v.z, v.serial] }.each do |vp|
    layer = vp.sprites.reject { |s| s.disposed? || !s.visible || s.opacity <= 0 || s.bitmap.nil? || s.bitmap.px.nil? }
    first = out.dup if vp.tone.red != 0 || vp.tone.green != 0 || vp.tone.blue != 0 || vp.tone.gray != 0
    layer.sort_by { |s| [s.z, s.serial] }.each do |s|
      bmp = s.bitmap; sr = s.src_rect
      zx = s.zoom_x.to_f; zy = s.zoom_y.to_f
      next if zx <= 0 || zy <= 0
      dw = (sr.width * zx).round; dh = (sr.height * zy).round
      x0 = s.x - (s.ox * zx).round; y0 = s.y - (s.oy * zy).round
      ca = s.color.alpha / 255.0; cr = s.color.red; cg = s.color.green; cb = s.color.blue
      op = s.opacity / 255.0
      xs = (0...dw).map { |i| u = (i / zx).floor; u = sr.width - 1 - u if s.mirror; sr.x + u.clamp(0, sr.width - 1) }
      dh.times do |j|
        dy = y0 + j
        next if dy < 0 || dy >= h
        sy = sr.y + (j / zy).floor.clamp(0, sr.height - 1)
        next if sy >= bmp.height
        row = sy * bmp.width
        dw.times do |i|
          dx = x0 + i
          next if dx < 0 || dx >= w
          sx = xs[i]
          next if sx >= bmp.width
          p = bmp.px[row + sx]
          a = (p & 255) * op / 255.0
          next if a <= 0
          r = p >> 24; g = (p >> 16) & 255; b = (p >> 8) & 255
          if ca > 0
            r += (cr - r) * ca; g += (cg - g) * ca; b += (cb - b) * ca
          end
          if a < 1
            q = out[(dy * w) + dx]
            r = (r * a) + ((q >> 24) * (1 - a)); g = (g * a) + (((q >> 16) & 255) * (1 - a)); b = (b * a) + (((q >> 8) & 255) * (1 - a))
          end
          out[(dy * w) + dx] = (r.round.clamp(0, 255) << 24) | (g.round.clamp(0, 255) << 16) | (b.round.clamp(0, 255) << 8) | 255
        end
      end
    end
    t = vp.tone
    if first
      out.each_index do |i|
        q = out[i]
        r = q >> 24; g = (q >> 16) & 255; b = (q >> 8) & 255
        if t.gray > 0
          l = (r * 0.3) + (g * 0.59) + (b * 0.11); k = t.gray / 255.0
          r += (l - r) * k; g += (l - g) * k; b += (l - b) * k
        end
        out[i] = ((r + t.red).round.clamp(0, 255) << 24) | ((g + t.green).round.clamp(0, 255) << 16) | ((b + t.blue).round.clamp(0, 255) << 8) | 255
      end
    end
    if vp.color.alpha > 0
      a = vp.color.alpha / 255.0
      out.each_index do |i|
        q = out[i]
        out[i] = (((q >> 24) * (1 - a) + vp.color.red * a).round << 24) | ((((q >> 16) & 255) * (1 - a) + vp.color.green * a).round << 16) |
                 ((((q >> 8) & 255) * (1 - a) + vp.color.blue * a).round << 8) | 255
      end
    end
  end
  out
end

def save_png(pixels, file)
  raw = file.sub(/\.png\z/, ".rgba")
  File.binwrite(raw, pixels.pack("N*"))
  system("convert", "-size", "#{Graphics.width}x#{Graphics.height}", "-depth", "8", "rgba:#{raw}", file)
  File.delete(raw)
end

#-------------------------------------------------------------------------------
# Load the plugin exactly as PluginManager would (every .rb, sorted)
#-------------------------------------------------------------------------------
def load_plugin
  core = ENV["PF_WITH_CORE_STUB"]
  Dir[File.join(PLUGIN_DIR, "**", "*")].select { |f| File.file?(f) && f.include?(".rb") }.sort.each { |f| load f }
end

def run_scene(id, vars = {})
  $clock = 0.0
  $max_fills = 0
  $fill_log = []
  $audio = []
  before = $live.dup
  cache0 = Prismfall::Cutscene::Gfx.placeholder_cache_size
  t0 = $clock
  Prismfall::Cutscene.raise_errors = true
  ok = id.is_a?(Proc) ? id.call : Prismfall::Cutscene.play(id, **vars)
  before[:bitmap] += Prismfall::Cutscene::Gfx.placeholder_cache_size - cache0   # shared placeholder sheets are cached on purpose
  leaks = $live.map { |k, v| [k, v - before[k]] }.reject { |_, v| v == 0 }
  { :ok => ok, :seconds => ($clock - t0).round(2), :max_fills => $max_fills,
    :avg_fills => ($fill_log.empty? ? 0 : $fill_log.sum / $fill_log.length), :leaks => leaks }
end

if __FILE__ == $0
  args = ARGV.dup
  if (i = args.index("--render"))
    id = args[i + 1].to_sym
    times = args[args.index("--at") + 1].split(",").map(&:to_f)
    out = args[args.index("--out") + 1]
    $opt[:assets] = args.include?("--assets")
    $opt[:render] = true
    $opt[:fps] = 30.0
    vars = {}
    args.each { |a| m = a.match(/\A(\w+)=(\w+)\z/); vars[m[1].to_sym] = (m[2] =~ /\A\d+\z/ ? m[2].to_i : m[2].to_sym) if m }
    load_plugin
    pending = times.sort
    require "fileutils"
    FileUtils.mkdir_p(out)
    $on_frame = proc do
      if pending[0] && $clock >= pending[0]
        t = pending.shift
        save_png(composite, File.join(out, format("%s_%06.2f.png", id, t)))
        $stderr.puts "rendered #{id} @ #{t}s"
      end
    end
    r = if id == :SAMPLE_HIGHLIGHT then run_scene(proc { Prismfall::Cutscene.play_sample_highlight })
        else run_scene(id, vars)
        end
    p r
    exit
  end
  load File.join(__dir__, "suite.ruby_stub")
end
