# Prismfall Cutscenes - self-test suite (run through harness.ruby_stub).
require "tmpdir"
require "fileutils"
$fails = []
$checks = 0
def check(name, cond, detail = nil)
  $checks += 1
  return if cond
  $fails.push("#{name}#{detail ? " (#{detail})" : ''}")
  puts "  FAIL #{name} #{detail}"
end
def section(name); puts "== #{name}"; end
CS = nil

# Core's real Festival data (MATCH_RULES) is used when it loads standalone.
begin
  load File.join(GAME_DIR, "plugins/Prismfall Core/008_Festival_Data.rb")
  load File.join(GAME_DIR, "plugins/Prismfall Core/015_Festival_Draw.rb")
rescue StandardError, ScriptError => e
  puts "(Core Festival files only partly loadable standalone: #{e.class}; MATCH_RULES #{defined?(Prismfall::Festival::MATCH_RULES) ? "available" : "missing"})"
end
load_plugin
C = Prismfall::Cutscene
C.raise_errors = true

section "meta + load"
meta = File.read(File.join(PLUGIN_DIR, "meta.txt"))
check "meta name", meta =~ /^Name\s*=\s*Prismfall Cutscenes$/
check "meta version", meta =~ /^Version\s*=\s*1\.0\.0$/
check "meta essentials", meta =~ /^Essentials\s*=\s*21\.1$/
check "meta optional core", meta =~ /^Optional\s*=\s*Prismfall Core,1\.0\.0$/
check "selftest files are not plugin scripts", Dir[File.join(PLUGIN_DIR, "selftest", "*")].none? { |f| f.sub(PLUGIN_DIR, "").include?(".rb") }
check "scenes registered", [:WAR_CLIMAX, :WAR_CLIMAX_DEMO].all? { |i| C.exists?(i) }

section "authoring errors are caught at define time"
err = (C.define(:BAD1) { move :ghost, to: [0, 0] } rescue $!)
check "unknown actor", err.is_a?(ArgumentError), err.inspect
err = (C.define(:BAD2) { teleport :x } rescue $!)
check "unknown command", err.is_a?(NoMethodError), err.class
err = (C.define(:BAD3) { actor :a, species: :PIKACHU; beam_clash a: :a, b: :a, winner: :nobody } rescue $!)
check "bad clash winner", err.is_a?(ArgumentError)

section "timing model"
d = C.build { actor :a, species: :PIKACHU; move :a, by: [10, 0], duration: 2; text "hi", duration: 1.5; together { wait 1; text "x", duration: 3 }; wait 0.5 }
check "tweens do not block, showpieces do", (d.length - 6.0).abs < 1e-6, d.length
d = C.build { actor :a, species: :PIKACHU; move :a, by: [1, 0], duration: 2, wait: true; text "a", duration: 1, wait: false; at(10) { text "late", duration: 1 } }
check "wait: overrides + at()", (d.length - 11.0).abs < 1e-6, d.length

# Gemini cinematics P0: slowmo(0.0) froze the scene clock forever; hitstop runs on the wall clock and ends.
C.define(:PF_HITSTOP_TEST) { text "a", duration: 0.2; hitstop 0.14; text "b", duration: 0.2 }
hs = run_scene(:PF_HITSTOP_TEST)
check "hitstop(0.14) ends on the wall clock", hs[:ok] != false && hs[:seconds] < 3.0 && hs[:leaks].empty?, hs.inspect

warm = run_scene(:WAR_CLIMAX_DEMO)   # fills the placeholder caches
section "example scenes at several frame rates (no assets)"
# slowmo stretches wall-clock time: dur scene-seconds take dur / scale real seconds
slow = proc { |d| d.events.select { |e| e.op == :slowmo }.sum { |e| (e.args[:scale].to_f <= 0.001) ? e.dur : e.dur * ((1.0 / e.args[:scale]) - 1) } }
war_d = C.build(:WAR_CLIMAX_DEMO)
base_len = { :WAR_CLIMAX_DEMO => war_d.length + slow.call(war_d), :HL => C.play_sample_highlight(play: false).length }
[[20, {}], [40, {}], [60, {}], [144, {}], [40, { :jitter => true }], [60, { :hitch => true }]].each do |fps, extra|
  $opt[:fps] = fps.to_f
  $opt[:jitter] = extra[:jitter]
  $opt[:hitch] = extra[:hitch]
  r = run_scene(:WAR_CLIMAX_DEMO)
  want = base_len[:WAR_CLIMAX_DEMO] + 0.3      # + fade back to the map
  # lag spikes are clamped to MAX_DT: the scene runs long instead of dropping content
  timed = (extra[:hitch]) ? r[:seconds] >= want - 0.8 : (r[:seconds] - want).abs < 0.8
  check "war demo @#{fps}#{extra.keys.join}", r[:ok] && r[:leaks].empty? && timed, r.inspect + " want #{want.round(2)}"
  r = run_scene(proc { C.play_sample_highlight })
  want = base_len[:HL] + 0.3
  timed = (extra[:hitch]) ? r[:seconds] >= want - 0.8 : (r[:seconds] - want).abs < 0.8
  check "highlight @#{fps}#{extra.keys.join}", r[:ok] && r[:leaks].empty? && timed, r.inspect
end
$opt[:fps] = 40.0
$opt[:jitter] = $opt[:hitch] = nil
puts "  war demo length #{base_len[:WAR_CLIMAX_DEMO].round(1)} s, sample highlight #{base_len[:HL].round(1)} s"

section "war climax variants"
[[:A, true], [:A2, true], [:B, true], [:C, true], [:A, false], [:B, false]].each do |v, legends|
  r = run_scene(:WAR_CLIMAX, variant: v, legends: legends)
  check "WAR_CLIMAX #{v} legends=#{legends}", r[:ok] && r[:leaks].empty?, r.inspect
  cues = $audio.select { |a| a[0] == :bgm }.map { |a| a[1] }
  check "audio order #{v}", cues == ["War - Battlefield", "War - Beam Clash", "War - Aftermath"], cues.inspect
  check "bgm restored #{v}", $audio.first == [:memorize] && $audio.include?([:restore])
end
check "clash result recorded", [:fizzle, :both].include?(C.result(:clash_winner)), C.result(:clash_winner).inspect

section "with real EBDX assets"
$opt[:assets] = true
r = run_scene(:WAR_CLIMAX, variant: :A)
r2 = run_scene(:WAR_CLIMAX, variant: :A)
check "war with assets", r[:ok] && r2[:leaks].empty?, r2.inspect
puts "  fill_rects per frame: max #{r2[:max_fills]}, mean #{r2[:avg_fills]}"
r = run_scene(proc { C.play_sample_highlight })
check "highlight with assets", r[:ok] && r[:leaks].empty?, r.inspect
$opt[:assets] = false

section "missing audio is silent"
$opt[:audio] = false
r = run_scene(proc { C.play_sample_highlight })
check "no audio files", r[:ok] && $audio.none? { |a| [:bgm, :se, :me].include?(a[0]) }, $audio.first(3).inspect
$opt[:audio] = nil

section "skip (hold BACK)"
$input_press = proc { |b| b == Input::BACK && $clock > 3.0 }
r = run_scene(:WAR_CLIMAX_DEMO)
$input_press = nil
check "skipped early", r[:ok] == false && C.skipped? && r[:seconds] < 5.5 && r[:leaks].empty?, r.inspect
C.define(:NOSKIP, skippable: false) { background :color, color: [0, 0, 0]; wait 2 }
$input_press = proc { |b| true }
r = run_scene(:NOSKIP)
$input_press = nil
check "skippable: false", r[:ok] == true && r[:seconds] > 2.0, r.inspect

section "mash-driven clash"
C.define(:MASH) do
  background :sea
  actor :l, species: :SQUIRTLE, at: [90, 300], flip: true
  actor :r, species: :CHARMANDER, at: [420, 300]
  beam_clash a: :l, b: :r, duration: 4, winner: :mash, curve: [[0, 0.5], [1, 0.4]], player: :a
end
r = run_scene(:MASH)
check "no mashing loses", r[:ok] && C.result(:clash_winner) == :b, C.result(:clash_winner).inspect
n = 0
$input_trigger = proc { |b| b == Input::USE && ((n += 1) % 4 == 0) }
r = run_scene(:MASH)
$input_trigger = nil
check "mashing wins", r[:ok] && C.result(:clash_winner) == :a, C.result(:clash_winner).inspect
[:a, :b, :both, :fizzle].each do |w|
  C.define(:"W_#{w}") do
    background :battlefield, palette: :scorched
    actor :l, species: :SQUIRTLE, at: [90, 300], flip: true
    actor :r, species: :CHARMANDER, at: [420, 260]
    beam_clash a: { from: :l, color: :water }, b: { from: :r, color: [255, 80, 40] }, duration: 3, winner: w
  end
  r = run_scene(:"W_#{w}")
  check "clash winner #{w}", r[:ok] && C.result(:clash_winner) == w && r[:leaks].empty?, r.inspect
end

section "every primitive in one scene"
C.define(:KITCHEN_SINK) do
  background :sky, palette: :night
  background :gradient, colors: [[0, 0, 0], [40, 40, 80]], y: 100, height: 60, parallax: 0.2
  background :mountains, snow: true
  background :sea, palette: :storm
  background :battlefield, palette: :snow, horizon: 300
  background :arena, tint: :grass
  background :fleet, x: 40
  background :fortress, x: 300, glow: [255, 200, 80]
  background image: "Graphics/Missing/nope"
  actor :p, species: :PIKACHU, at: [100, 300], back: true, shiny: true, scale: 2, silhouette: true
  actor :t, trainer: :LEADER_ANJA, at: [200, 300], tint: [255, 0, 0, 90]
  actor :c, charset: "NPC 01", at: [300, 300], dir: :left, walk: true
  actor :i, icon: :EEVEE, at: [360, 300]
  actor :pl, player: true, at: [400, 300]
  actor :pr, prop: :banner, at: [440, 300]
  actor :img, image: "Graphics/Missing/nope", at: [480, 300]
  army :x, count: 7, color: [90, 200, 90]
  army :y, icons: [:ZUBAT], count: 5, area: [300, 250, 150, 40], facing: :left
  letterbox true
  together do
    move :p, to: :t, duration: 1, arc: 30, ease: :out_bounce
    scale :t, to: 2, duration: 1
    rotate :c, by: 360, duration: 1
    fade :i, to: 0, duration: 1
    tint :pl, color: :fire, amount: 255, duration: 1
    pan to: :t, zoom: 1.5, duration: 1
    tone to: [40, 0, -40, 80], duration: 1
    shake power: 8, duration: 1
    flash color: [255, 0, 0], duration: 1
    march :x, by: [60, 0], duration: 1
    overlay :burning, level: 1.0, duration: 1
    overlay :freezing, level: 1.0, duration: 1
    hp_bar :p, value: 0.1, duration: 1
    dome at: :t, radius: 200, duration: 1
    wait 1
  end
  [:embers, :snow, :rain, :debris, :sparks, :smoke, :steam, :ice_shards, :petals, :motes].each do |k|
    emit k, rate: 40, duration: 0.5
    emit k, at: :p, rate: 40, duration: 0.5, layer: :back, id: :"e_#{k}"
    burst k, at: [256, 200], count: 8, color: :dragon
  end
  overlay :freezing, level: 0.2, duration: 0.3
  flip :p; face :c, :up; hop :p; tremble :t; hit :p, dir: 1
  zoom to: 1.0, duration: 0.3
  lunge :p, toward: :t
  charge_up at: :p, color: :electric
  beam from: :p, to: :y, color: :electric
  beam from: [10, 10], to: [500, 370], color: :ghost, duration: 0.6
  beam from: [256, 40], to: [250, 370], color: :grass, duration: 0.6
  impact at: :t, color: :fire, shake: 4
  ring at: [256, 300], radius: 120
  volley from: :x, to: :y, kind: :arrow, count: 9, casualties: 0.5, shake: true
  volley from: [0, 0, 100, 10], to: :t, kind: :ice, duration: 0.8
  clash_armies :x, :y, duration: 2
  army_tint :x, color: :bleed
  army_fall :y, fraction: 1.0
  rout :x, duration: 0.5
  text "Top", position: :top, duration: 0.6
  text "A long centred caption that has to wrap over more than one line to fit the screen width.", position: :center, duration: 0.8
  say "Speaker", "Line.", duration: 0.8
  title "TITLE", sub: "sub", duration: 0.8
  vs_card a: { name: "A", trainer: :LEADER_ANJA, team: [:EEVEE, :PIKACHU] }, b: { name: "B", trainer: :X }, duration: 1.2
  bgm "Some BGM"; bgs "Rain"; se "x"; me "y"; cry :PIKACHU; bgm_fade 0.2; bgs_fade 0.2
  cut at: [100, 100], zoom: 2
  camera at: :p, zoom: 1
  dome hole_at: :p, hole: 30, duration: 0.2
  dome off: true
  stop_emit :e_snow
  stop_emit
  faint :p
  remove :t
  clear_backgrounds
  clear_actors
  call { |scene| scene.results[:called] = true }
  fade_out duration: 0.2
  fade_in duration: 0.2
  letterbox false
end
[false, true].each do |assets|
  $opt[:assets] = assets
  r = run_scene(:KITCHEN_SINK)
  r = run_scene(:KITCHEN_SINK)
  check "kitchen sink assets=#{assets}", r[:ok] && r[:leaks].empty? && C.result(:called), r.inspect
end
$opt[:assets] = false

section "Rejuvenation-style techniques"
sheet_dir = Dir.mktmpdir("pf_sheet")
FileUtils.mkdir_p(File.join(sheet_dir, "Graphics/Characters"))
FileUtils.mkdir_p(File.join(sheet_dir, "Graphics/Pictures"))
system("convert", "-size", "128x192", "xc:none", "-fill", "red", "-draw", "rectangle 0,0 31,47", File.join(sheet_dir, "Graphics/Characters/FlipTest.png"))
system("convert", "-size", "512x384", "xc:navy", File.join(sheet_dir, "Graphics/Pictures/Storyboard_T.png"))
old_assets = ASSET_DIR
Object.send(:remove_const, :ASSET_DIR); ASSET_DIR = sheet_dir
$opt[:assets] = true
frames_seen = []
C.define(:TECHNIQUES) do
  background :color, color: [20, 20, 30]
  actor :fx, sheet: "Graphics/Characters/FlipTest", grid: [4, 4], at: [256, 300], frame: 0
  actor :ghost, sheet: "Graphics/Characters/Missing", at: [100, 300]
  pose :fx, row: 2, col: 1
  call { |sc| frames_seen.push(sc.actors[:fx].cell.dup) }
  flipbook :fx, frames: [0, 1, 2, 3, [1, 0]], hold: 0.1, se: { 2 => "Anim/Explosion" }, wait: true
  wait 0.05
  call { |sc| frames_seen.push(sc.actors[:fx].cell.dup) }
  flipbook :fx, frames: 4..7, holds: [0.05, 0.05, 0.3, 0.05], loops: 2, end_frame: 0, wait: true
  wait 0.05
  call { |sc| frames_seen.push(sc.actors[:fx].cell.dup) }
  pulse tone: [-68, -102, -102, 120], duration: 0.15, times: 2
  fade :fx, to: 0, steps: 5, duration: 0.25
  still "Graphics/Pictures/Storyboard_T", duration: 1.0, fade: 0.25, steps: 5, dim: 120
  still "Graphics/Pictures/Nope", duration: 0.5
  anim 3, at: :fx
  fade_out steps: 5, duration: 0.25
end
blends = []
cams = []
C.define(:TECH2) do
  background :color, color: [0, 0, 0]
  actor :glow, sheet: "Graphics/Characters/FlipTest", at: [100, 300], blend: :add
  actor :hole, sheet: "Graphics/Characters/FlipTest", at: [200, 300], blend: :sub
  actor :runner, charset: "NPC 01", at: [0, 300]
  call { |sc| blends.push(sc.actors[:glow].sprite.blend_type, sc.actors[:hole].sprite.blend_type) }
  4.times { |i| at(0.2 + (i * 0.1)) { play_sheet "Graphics/Characters/FlipTest", grid: [4, 4], frames: 0..3, at: [100 + (i * 60), 280], hold: 0.05 } }
  follow :runner, smooth: 0.2
  move :runner, to: [400, 300], duration: 1.0, ease: :linear
  wait 1.6
  call { |sc| cams.push(sc.camera.x.round, sc.actors.keys.count { |k| k.to_s.start_with?("__fx") }) }
  follow off: true
  pan to: [256, 192], duration: 0.3
end
r = run_scene(:TECH2)
check "blend modes", blends == [1, 2], blends.inspect
check "play_sheet chain cleans up; camera followed", r[:ok] && r[:leaks].empty? && cams == [[400, 0]].flatten, [r, cams].inspect
d = C.build(:TECHNIQUES)
check "flipbook durations", (C.build { actor :a, sheet: "x"; flipbook :a, frames: 0..3, hold: 0.25, wait: true }.length - 1.0).abs < 1e-6
r = run_scene(:TECHNIQUES)
check "techniques scene", r[:ok] && r[:leaks].empty?, r.inspect
check "pose and flipbook cells", frames_seen == [[2, 1], [1, 0], [0, 0]], frames_seen.inspect
check "flipbook SE cue", $audio.any? { |x| x[0] == :se && x[1] == "Anim/Explosion" }
check "stepped ease", C::Ease.apply(:step5, 0.39) == 0.2 && C::Ease.apply(:step5, 1.0) == 1.0
# database animation through a stand-in RPG::Sprite
module RPG
  class Sprite < ::Sprite
    def animation(anim, hit, height = 3); @left = 6; ($anims ||= []).push(anim); end
    def effect?; return (@left || 0) > 0; end
    def update; @left -= 1 if @left; end
  end
end
$data_animations = [nil, :grass, :dust, :exclaim]
$anims = []
r = run_scene(:TECHNIQUES)
check "database animation", r[:ok] && r[:leaks].empty? && $anims == [:exclaim], [$anims, r].inspect
# on-map mode: no black curtain, actor follows an event
$game_map.events = { 7 => EventStub.new("Juno", 300, 200) }
spots = []
C.define(:ONMAP, on_map: true) do
  actor :mark, sheet: "Graphics/Characters/FlipTest", event: 7, offset: [0, -40]
  wait 0.3
  call { |sc| spots.push(sc.actors[:mark].pos, sc.curtain) }
  flipbook :mark, frames: 0..3, hold: 0.1, wait: true
end
r = run_scene(:ONMAP)
check "on-map scene", r[:ok] && r[:leaks].empty? && spots == [[300.0, 160.0], 0.0] && r[:seconds] < 0.9, [r, spots].inspect
# war climax uses overworld-scale legend sheets when they exist
FileUtils.mkdir_p(File.join(sheet_dir, "Graphics/Characters"))
system("convert", "-size", "552x360", "xc:none", "-fill", "#2050c0", "-draw", "rectangle 20,20 120,80", File.join(sheet_dir, "Graphics/Characters/pkmn_kyogre_war.png"))
dw = C.build(:WAR_CLIMAX, variant: :A)
ops = dw.events.map(&:op)
check "on-map war climax uses the games' overworld sheets",
      dw.events.any? { |e| e.op == :actor && e.args[:id] == :water && e.args[:sheet].to_s.include?("pfw_kyogre") } &&
      dw.events.any? { |e| e.op == :actor && e.args[:id] == :fire && (e.args[:sheet].to_s + e.args[:charset].to_s).include?("pfw_reshiram") } &&
      dw.events.none? { |e| e.op == :actor && [:water, :fire].include?(e.args[:id]) && e.args[:species] } &&
      dw.events.any? { |e| e.op == :beam_clash && e.args[:style] == :sheet } &&
      [:fx_sheet, :flipbook, :idle, :shadow].all? { |o| ops.include?(o) }, ops.uniq.inspect
sheets = dw.events.select { |e| e.op == :fx_sheet }.map { |e| e.args[:sheet].to_s }
says = dw.events.select { |e| e.op == :text }.map { |e| e.args[:text].to_s }.join(" | ")
check "war climax on the Glass Dunes (Rev 18): flood in and out, glass trail, glass ring, new lines",
      dw.events.any? { |e| e.op == :background && e.args[:image].to_s.include?("pfw_glass_dunes") } &&
      dw.events.count { |e| e.op == :flipbook && e.args[:id] == :flood } == 2 &&
      sheets.count { |n| n.include?("pfw_fx_glass_patch") } >= 7 && sheets.any? { |n| n.include?("pfw_fx_glass_ring") } &&
      dw.events.any? { |e| e.op == :actor && e.args[:sheet].to_s.include?("pfw_fx_glass_wave") } &&
      says.include?("The sea has come to the sand!") && !says.include?("remembers it's a sea"), says
nl = C.build(:WAR_CLIMAX, variant: :A, legends: false)
check "no-legend war climax has no flood",
      nl.events.none? { |e| e.op == :actor && e.args[:id] == :flood } &&
      nl.events.any? { |e| e.op == :actor && e.args[:id] == :water && e.args[:charset].to_s.include?("pfw_gyarados") }
pd = C.build(:WAR_CLIMAX_PROCEDURAL, variant: :A)
check "procedural war climax on dunes", pd.events.any? { |e| e.op == :background && e.args[:kind] == :dunes } &&
                                        pd.events.none? { |e| e.op == :background && e.args[:kind] == :floes }
dw = C.build(:WAR_CLIMAX_PROCEDURAL, variant: :A)
check "legend sheet picked up", dw.events.any? { |e| e.op == :actor && e.args[:id] == :water && e.args[:sheet] } &&
                                dw.events.any? { |e| e.op == :actor && e.args[:id] == :fire && e.args[:species] }
r = run_scene(:WAR_CLIMAX_PROCEDURAL, variant: :A)
check "war climax with a legend sheet", r[:ok] && r[:leaks].empty?, r.inspect
# photosensitive mode
C.photosensitive = true
peak = 0
$on_frame = proc { sc = C.current; next if !sc; peak = [peak, sc.camera.sx.abs, sc.camera.sy.abs].max; }
r = run_scene(:WAR_CLIMAX_DEMO)
$on_frame = nil
check "photosensitive: no impact frames, little shake", r[:ok] && peak <= 6, peak
C.photosensitive = nil
FileUtils.rm_rf(sheet_dir)
Object.send(:remove_const, :ASSET_DIR); ASSET_DIR = old_assets
$opt[:assets] = false

section "a broken scene never softlocks"
C.define(:BROKEN) { background :sea; wait 0.5; call { |_s| raise "boom" }; wait 1 }
C.raise_errors = false
before = $live.dup
ok = C.play(:BROKEN)
check "error -> false, cleaned up", ok == false && $live == before && !C.playing?, [$live, before].inspect
C.raise_errors = true

section "Core's match_highlight call (positional hashes + MATCH_RULES rows)"
info = proc { |id| { :id => id, :name => id.to_s.capitalize, :trainer_type => :"LEADER_#{id}" } }
rules = (defined?(Prismfall::Festival::MATCH_RULES)) ? Prismfall::Festival::MATCH_RULES : nil
puts "  using #{rules ? "Core's #{rules.length} MATCH_RULES" : 'built-in sample rows (Core data not loadable standalone)'}"
rules ||= [{ :pair => [:ANJA, :BRANN], :winner => :ANJA, :moments => [[:BRANN, :COALOSSAL, :send_out, "a"], [:ANJA, :MAMOSWINE, :beam_clash, "b"], [:BRANN, :COALOSSAL, :faint, "c"]] }]
events = []
rules.each_with_index do |rule, i|
  a, b = rule[:pair]
  d = C.match_highlight(info.call(a), info.call(b), info.call(rule[:winner]), rule[:moments], play: false)
  events.concat(rule[:moments].map { |m| m[2] })
  check "rule #{i} #{a} v #{b} length 15-30s", d.is_a?(C::Definition) && d.length >= 15.0 && d.length <= 30.0, d.length.round(1)
  next if i % 3 != 0
  r = run_scene(proc { C.match_highlight(info.call(a), info.call(b), info.call(rule[:winner]), rule[:moments]) })
  check "rule #{i} plays", r[:ok] && r[:leaks].empty?, r.inspect
end
puts "  events covered by Core data: #{events.uniq.join(' ')}"
all = C::Highlight::EVENTS - [:exchange, :clutch, :walk_off]
rows = all.map { |e| [:ANJA, :MAMOSWINE, e, "Caption for #{e}."] }
all.each_slice(3).each_with_index do |evs, i|
  r = run_scene(proc { C.match_highlight(info.call(:ANJA), info.call(:BRANN), info.call(:BRANN), evs.map { |e| [(e == :faint) ? :ANJA : :BRANN, :ARCANINE, e, "Caption #{e}"] }) })
  check "event templates #{evs.join('/')}", r[:ok] && r[:leaks].empty?, r.inspect
end
d = C.match_highlight(info.call(:ANJA), info.call(:BRANN), info.call(:BRANN), rows, play: false)
check "too many moments trimmed to <= 30s", d.length <= 30.0, d.length
section "keyword / template forms"
[[:opening, :super_effective, :final_blow, :walk_off], [:clutch, :beam_clash], nil, [:final_blow]].each do |m|
  r = run_scene(proc { C.match_highlight([:LEADER_TAMSIN, "Tamsin", 0], { :name => "Nobody", :team => [:GARCHOMP, :MILOTIC] }, winner: :b, moments: m) })
  d = C.match_highlight([:LEADER_TAMSIN, "Tamsin", 0], { :name => "Nobody", :team => [:GARCHOMP, :MILOTIC] }, winner: :b, moments: m, play: false)
  check "templates #{m.inspect}", r[:ok] && r[:leaks].empty? && d.length.between?(15.0, 30.0), [r, d.length].inspect
end
t = C::Highlight.trainer_info([:LEADER_TAMSIN, "Tamsin", 0])
check "team read from pbs/trainers.txt", t[:team].first == :JOLTIK, t[:team].inspect
$messages = []
check "offer hook asks first", C.offer_festival_highlight(info.call(:ANJA), info.call(:BRANN), :ANJA) == true && $messages.include?("Watch the highlights?")

section "portraits: tags and modes"
P = Prismfall::Portrait
$game_map.events = { 1 => EventStub.new("Delphine", 200, 220), 2 => EventStub.new("Sign", 400, 120), 3 => EventStub.new("Edge", 500, 20), 4 => EventStub.new("Far", 2000, 900) }
text, spec = P.extract("\\pf[MARTIN,crying]MARTIN: Waaah!")
check "tag parsed", text == "MARTIN: Waaah!" && spec == { :id => :MARTIN, :expression => :crying, :emotes => nil, :event => nil, :bubble => false }, [text, spec].inspect
text, spec = P.extract("[portrait: Martin, Smug] Obviously.")
check "story tag parsed", text == "Obviously." && spec[:id] == :MARTIN && spec[:expression] == :smug && !spec[:bubble], [text, spec].inspect
text, spec = P.extract("\\PF[martin, shocked, sweat+exclaim, 3]Hi")
check "emotes + event", spec[:emotes] == [:sweat, :exclaim] && spec[:event] == 3, spec.inspect
text, spec = P.extract("\\pfb[LARCH,angry,anger,Professor Larch]Larch: IT LIVES IN A TREE.")
check "\\pfb asks for the bubble", text == "Larch: IT LIVES IN A TREE." && spec[:bubble] == true && spec[:event] == "Professor Larch" && spec[:emotes] == [:anger], [text, spec].inspect
text, spec = P.extract("[bubble: Juno, panic, sweat] Juno: Shutting up!")
check "[bubble: ...] story tag", text == "Juno: Shutting up!" && spec[:bubble] == true && spec[:id] == :JUNO, [text, spec].inspect
check "no tag untouched", P.extract("Plain \\c[2]text") == ["Plain \\c[2]text", nil]
check "label of a line", P.label_of("\\c[1]Juno: hi") == "juno" && P.label_of("(She waits.)").nil? && P.label_of("Accord guard (aside): x") == "accord guard (aside)"
check "no art -> plain, even for the cast", P.mode_for(P.parse("JUNO,happy")) == :plain && P.mode_for(P.parse("LARCH,angry", true)) == :bubble &&
      P.mode_for(P.parse("SHOPKEEPER,happy", true)) == :plain && P.mode_for(nil) == :plain
seen = []
P.singleton_class.send(:alias_method, :open_real, :open)
P.define_singleton_method(:open) { |sp, win = nil, mode = nil| b = open_real(sp, win, mode); seen.push(b); b }
before = $live.dup

section "portraits: plain box (not cast, or no art yet)"
$shown = []
pbMessage("Just text.")
check "plain message passes through", $shown.last == "Just text." && seen.empty?
P.register(:DELPHINE, cast: true)   # the suite's own artless cast member (the game aliases DELPHINE to Okoro's art)
pbMessage("\\pf[DELPHINE,crying]Delphine: I LEFT THE OVEN ON!")
pf_say(:JUNO, :happy, "No art in this run.")
check "cast without art: plain box, tag stripped, no silhouette", seen.empty? && $shown[-2] == "Delphine: I LEFT THE OVEN ON!" &&
      $shown.last == "Juno: No art in this run." && P.current.nil?, [seen.length, $shown.last(2)].inspect
pbMessage("\\pf[SHOPKEEPER,happy]Shopkeeper: Welcome!")
pf_say(:ACCORD_GUARD, :angry, "Halt.")
pf_say(:ACCORD_GUARD, :angry, "Halt!", bubble: true, emote: :anger)
pbMessage("\\pfb[ACCORD_GUARD,deadpan,sweat,Accord guard](They notice you listening.)")
check "non-cast speakers get the plain box in both modes", seen.empty? && $shown[-3] == "Accord Guard: Halt." && $shown[-2] == "Accord Guard: Halt!" &&
      $shown.last == "(They notice you listening.)" && P.current.nil?, [seen.length, $shown.last(3)].inspect

section "portraits: speech bubbles (opt-in)"
pbMessage("\\pfb[DELPHINE,crying]DELPHINE: I LEFT THE OVEN ON!")
b = seen.last
check "bubble opened, text cleaned, closed", b.is_a?(P::Bubble) && $shown.last == "DELPHINE: I LEFT THE OVEN ON!" && P.current.nil? && $live == before, [b.class, $shown.last, $live, before].inspect
check "anchored above the named event", b && (b.center[0] - 200).abs <= 2 && b.center[1] < 180, b && b.center.inspect
check "silhouette fallback + face emotes", b && b.art_kind == :silhouette && b.emotes == [:sweat, :tears], b && [b.art_kind, b.emotes].inspect
P.register(:NOBODY, cast: true)
pf_say(:NOBODY, :deadpan, "Hm.", bubble: true)
# event 2 stands near the top edge, so the bubble sits beside it instead of over it
check "pf_say(bubble: true) falls back to the running event", $shown.last == "Nobody: Hm." && seen.last.is_a?(P::Bubble) && (seen.last.center[0] - 400).abs.between?(60, 110), [$shown.last, seen.last.center].inspect
pf_say(:DELPHINE, :panic, "Edge!", event: 3, emote: [:question, :anger], name: false, bubble: true)
c = seen.last.center
check "clamped on screen, emote override", $shown.last == "Edge!" && c[0] <= 512 - 54 && c[1] >= 54 && seen.last.emotes == [:question, :anger], [c, seen.last.emotes].inspect
pf_say(:DELPHINE, :happy, "Off-screen speaker", event: 4, bubble: true)
check "off-screen speaker -> above the box", seen.last.center[1] < $msg_y && seen.last.center[0] < 120, seen.last.center.inspect
$msg_y = 0
pf_say(:PLAYER, :sad, "Top box", bubble: true)
check "message box at top", seen.last.center[1] > 96, seen.last.center.inspect
$msg_y = 288
$game_player = Struct.new(:character_name, :screen_x, :screen_y).new("x", 256, 192)
n0 = seen.length
P::EXPRESSIONS.each_key { |e| pf_say(:PLAYER, e, "x", emote: P::EMOTES, bubble: true) }
P::EXPRESSIONS.each_key { |e| pbMessage("\\pfb[DELPHINE,#{e}]x") }
pf_say(:DELPHINE, :not_an_expression, "x", emote: :not_an_emote, bubble: true)
n_expr = (P::EXPRESSIONS.length * 2) + 1
check "all expressions x all emotes, no leaks", $live == before && seen.length - n0 == n_expr && seen.last(n_expr).all? { |v| v.is_a?(P::Bubble) }, [seen.length - n0, $live].inspect
$opt[:assets] = true
P.register(:DELPHINE, name: "Delphine", trainer: :LEADER_MARTIN, color: [200, 60, 60], cast: true)
pf_say(:DELPHINE, :angry, "With a trainer sprite.", bubble: true)
check "trainer-sprite head crop", seen.last.art_kind == :sprite && $shown.last.start_with?("Delphine: "), seen.last.art_kind
n0 = seen.length
pf_say(:DELPHINE, :angry, "Still no portrait art.")
check "...but a sprite is not portrait art: no face (plain box)", seen.length == n0 && $shown.last == "Delphine: Still no portrait art." && P.current.nil?, seen.length - n0
tmp = Dir.mktmpdir("pf_portraits")
FileUtils.mkdir_p(File.join(tmp, "Graphics/Portraits"))
system("convert", "-size", "96x96", "xc:orange", File.join(tmp, "Graphics/Portraits/DELPHINE_crying.png"))
system("convert", "-size", "48x48", "xc:teal", File.join(tmp, "Graphics/Portraits/DELPHINE.png"))
real_assets = ASSET_DIR
Object.send(:remove_const, :ASSET_DIR)
ASSET_DIR = tmp
pf_say(:DELPHINE, :crying, "x", bubble: true)
k1 = [seen.last.art_kind, seen.last.emotes]
pf_say(:DELPHINE, :smug, "x", bubble: true)
k2 = seen.last.art_kind
check "bubble art: NAME_expression.png then NAME.png", k1 == [:expression, [:sweat]] && k2 == :base, [k1, k2].inspect

section "portraits: face mode (the default once art exists)"
pf_say(:DELPHINE, :smug, "Face from the 48 px base file.")
f = seen.last
check "face: NAME.png fallback, scaled to 96", f.is_a?(P::FaceBox) && f.file.to_s.end_with?("DELPHINE.png") && $shown.last == "Delphine: Face from the 48 px base file.", [f.class, f.file].inspect
check "face: no skin file -> drawn frame, no leaks", P.current.nil? && $live == before, $live.inspect
FileUtils.rm_rf(tmp)
Object.send(:remove_const, :ASSET_DIR)
ASSET_DIR = real_assets
skin, own = P::Frame.skin_for(nil)
check "frame skin: the stock speech frame (96x48)", skin && own && skin.width == 96 && skin.height == 48, skin && [skin.width, skin.height].inspect
xp = Bitmap.new(192, 128)
vx = Bitmap.new(128, 128)
check "frame region: speech / XP / VX skins", P::Frame.region(skin, nil) == [0, 0, 96, 48, 40, 24, 16, nil] &&
      P::Frame.region(xp, nil)[0, 4] == [128, 0, 64, 64] && P::Frame.region(vx, nil)[0, 4] == [64, 0, 64, 64]
[skin, xp, vx].each(&:dispose)
P.new_conversation
P.instance_variable_set(:@last_face, nil)
pf_say(:JUNO, :happy, "You walked through the Bleed like it was fog.")
f = seen.last
check "Juno: face mode, her happy file, name label kept", f.is_a?(P::FaceBox) && File.basename(f.file.to_s) == "JUNO_happy.png" && $shown.last == "Juno: You walked through the Bleed like it was fog.", [f.class, f.file, $shown.last].inspect
check "new speaker pops in", f.entry == :pop, f.entry
check "beside the box on the left, above it", f.rect == [0, 288 - 128, 128, 128], f.rect.inspect
pf_say(:JUNO, :happy, "Nobody does that.")
check "same speaker, same face: no pop", seen.last.entry == :none, seen.last.entry
pbMessage("\\pf[JUNO,sad]Juno: Biscuit's in there somewhere.")
check "same speaker, new expression: a small swap", seen.last.entry == :swap && File.basename(seen.last.file) == "JUNO_sad.png", [seen.last.entry, seen.last.file].inspect
pbMessage("\\pf[JUNO,wink]Juno: Any expression name works if the file exists.")
pbMessage("\\pf[JUNO,grumpy]Juno: ...else her base file.")
check "expression picks the file (ID_expr.png, else ID.png)", File.basename(seen[-2].file) == "JUNO_wink.png" && File.basename(seen[-1].file) == "JUNO.png", [seen[-2].file, seen[-1].file].inspect
pbMessage("\\pf[JUNO,sad]Juno: Please be careful.")
n1 = seen.length
pbMessage("Juno: (a name-only line in the same conversation)")
check "name-only follow-up keeps her face and expression", seen.length == n1 + 1 && seen.last.is_a?(P::FaceBox) && File.basename(seen.last.file) == "JUNO_sad.png" &&
      seen.last.entry == :none && $shown.last == "Juno: (a name-only line in the same conversation)", [seen.length - n1, seen.last.file].inspect
pbMessage("Kestrel: Not tagged here, no art.")
pbMessage("(Narration.)")
pbMessage("Junonia: Not her.")
check "others' and narration lines stay plain", seen.length == n1 + 1, seen.length - n1
pbMessage("Juno: Back again.")
check "...and her face comes back (pops: the box was hers no longer)", seen.length == n1 + 2 && seen.last.entry == :pop, [seen.length - n1, seen.last.entry].inspect
pbMessage("\\pf[LARCH,deadpan]Larch: I've watched forty people pretend.")
check "Larch: his own face, popping in", seen.last.is_a?(P::FaceBox) && File.basename(seen.last.file) == "LARCH_deadpan.png" && seen.last.entry == :pop, seen.last.file
pbMessage("\\pfb[LARCH,angry,anger,1]Larch: IT LIVES IN A TREE.")
check "bubble with real art: round crop of his file", seen.last.is_a?(P::Bubble) && seen.last.art_kind == :expression && seen.last.emotes == [:anger], [seen.last.class, seen.last.art_kind].inspect
pbMessage("\\pfb[JUNO,surprised]Juno: Eh?")
check "bubble: an expression outside the list still finds its file", seen.last.is_a?(P::Bubble) && seen.last.art_kind == :expression, seen.last.art_kind
pbMessage("Larch: A name-only line after the bubble goes back to his face.")
check "after a bubble line: the face again", seen.last.is_a?(P::FaceBox) && File.basename(seen.last.file) == "LARCH_angry.png", seen.last.file
P.new_conversation
n2 = seen.length
pbMessage("Juno: A new conversation starts fresh.")
check "new conversation: no carry-over", seen.length == n2, seen.length - n2
$msg_y = 0
pf_say(:JUNO, :happy, "Box at the top.")
check "box at the top: face below it", seen.last.rect == [0, 96, 128, 128], seen.last.rect.inspect
$msg_y = 144
pf_say(:JUNO, :happy, "Box in the middle.")
check "box in the middle: face above it", seen.last.rect == [0, 16, 128, 128], seen.last.rect.inspect
$msg_y = 288
$player = Struct.new(:character_ID).new(2)
pf_say(:PLAYER, :happy, "Style B.", name: "Tester")
fb = File.basename(seen.last.file.to_s)
$player.character_ID = 1
pf_say(:PLAYER, :smug, "Style A.", name: "Tester")
check ":PLAYER uses PLAYER_A / PLAYER_B art by the chosen look", fb == "PLAYER_B_happy.png" && File.basename(seen.last.file.to_s) == "PLAYER_A_smug.png", [fb, seen.last.file].inspect
P.instance_variable_set(:@last_face, nil)
win = MsgWindowStub.new(288, 96, nil, 0)
box = P::FaceBox.new(P.parse("JUNO,happy"), win)
fr = box.instance_variable_get(:@frame)
fa = box.instance_variable_get(:@face)
a0 = [fr.opacity, fr.y, fa.y]
$clock += P::FACE_POP / 2
box.update
a1 = [fr.opacity, fr.y]
$clock += P::FACE_POP
box.update
a2 = [fr.opacity, fr.y, fr.x, fa.x, fa.y]
box.dispose
check "pop-in: rises 8 px out of the box and fades in, then rests", a0[0] == 0 && a0[1] == 168 && a0[2] == 184 && a1[0].between?(1, 254) && a1[1].between?(160, 166) &&
      a2 == [255, 160, 0, 16, 176], [a0, a1, a2].inspect
box = P::FaceBox.new(P.parse("JUNO,sad"), win)
s0 = [box.entry, box.instance_variable_get(:@face).y, box.instance_variable_get(:@frame).opacity]
box.dispose
check "expression swap: frame stays put, face nudges 2 px", s0 == [:swap, 178, 255], s0.inspect
$opt[:assets] = false
$player = nil
check "portraits leave nothing behind", $live == before, [$live, before].inspect

section "Trials talk rows (004_Trials_Script.rb)"
begin
  load File.join(GAME_DIR, "plugins/Prismfall Trials/004_Trials_Script.rb")
  tr = Prismfall::Trials
  $opt[:assets] = true
  n3 = seen.length
  tr.say(:JUNO, :happy, "Face by default.")
  r1 = [seen.last.class, $shown.last]
  tr.say(:LARCH, :angry, "Bubble on request.", nil, 0, :bubble)
  r2 = seen.last.class
  tr::Script.exec_one([:LARCH, :crying, "It's the tea.", { :bubble => true, :emote => [:sweat], :event => 1 }], { :quest => :TEST, :scene => :t })
  r3 = [seen.last.class, seen.last.emotes, seen.last.spec[:event]]
  tr::Script.exec_one([:JUNO, :panic, "Shutting up!", :bubble], { :quest => :TEST, :scene => :t })
  r4 = seen.last.class
  P.register(:NOART_FIXTURE, name: "Kassan", cast: true)   # Kassan himself has art since Art Drop 15
  tr::Script.exec_one([:NOART_FIXTURE, :happy, "No art yet."], { :quest => :TEST, :scene => :t })
  r5 = [seen.length - n3, $shown.last]
  $menu_choice = 1
  idx = tr::Script.exec_one({ :choice => [:JUNO, :neutral, "Pull me through?", :bubble], :options => [["No.", []], ["Yes.", []]] }, { :quest => :TEST, :scene => :t })
  r6 = seen.last.class
  $menu_choice = 0
  check "say: face by default, name label kept", r1[0] <= P::FaceBox && r1[1] == "Juno: Face by default.", r1.inspect
  check "say(..., :bubble) and [.., :bubble] rows", r2 == P::Bubble && r4 == P::Bubble && r6 == P::Bubble, [r2, r4, r6].inspect
  check "row option hash: bubble + emote + event", r3 == [P::Bubble, [:sweat], 1], r3.inspect
  check "cast without art: plain box", r5 == [4, "Kassan: No art yet."], r5.inspect
  err = (tr.line_style(:bubbel) rescue $!)
  check "a mistyped row option is an error", err.is_a?(ArgumentError), err.inspect
rescue StandardError, ScriptError => e
  check "Trials script loads standalone", false, "#{e.class}: #{e.message} #{e.backtrace.first}"
ensure
  $opt[:assets] = false
end
check "trials lines leave nothing behind", $live == before, [$live, before].inspect

section "expressive conversations (018): the two-speaker stage"
X = Prismfall::Expressive
$opt[:assets] = true
P.new_conversation
P.instance_variable_set(:@last_face, nil)
t0, d0 = X.extract_inline_tags("[portrait: KESTREL, sad]\\pfe[dots]\\pfp[guarded]\\pfa[step_back] Kestrel: ...Keep off the ridge.")
t1, d1 = X.extract_inline_tags("[name: Juno] [emote: question, Kestrel] Why?")
check "acting tags stripped, portrait tag left for 014", t0 == "[portrait: KESTREL, sad] Kestrel: ...Keep off the ridge." &&
      d0 == { :emotes => [{ :kind => "dots", :target => nil }], :pose => { :pose => "guarded", :target => nil }, :act => { :kind => "step_back", :target => nil } } &&
      t1 == "[name: Juno] Why?" && d1[:emotes] == [{ :kind => "question", :target => "Kestrel" }], [t0, d0, t1, d1].inspect
check "emote names and aliases", X.resolve_emote("Dots") == :dots && X.resolve_emote(:shock) == :double_exclaim && X.resolve_emote(:nope).nil?
trace = []
$on_frame = proc do
  v = P.current
  next if !v.is_a?(X::StageView)
  trace.push(v.panels.map { |pn| [pn.side, pn.id] + pn.sprites.map { |s| [s.x, s.y] } + [pn.sprites[0].tone.red.round, pn.sprites[1].opacity] })
end
pbMessage("\\pf[JUNO,happy]Juno: Kestrel! You came back.")
v1 = seen.last
a1 = trace.dup
trace.clear
pbMessage("\\pf[KESTREL,deadpan]Kestrel: Don't make a fuss.")
v2 = seen.last
a2 = trace.dup
trace.clear
check "first speaker: left, fades in, alone", v1.is_a?(X::StageView) && v1.side == :left && v1.entry == :pop && v1.listener.nil? && v1.rect == [0, 160, 128, 128], [v1.class, v1.side, v1.entry, v1.rect].inspect
check "fade in is alpha only", a1.first[0][-1] < 255 && a1.last[0][-1] == 255 && a1.map { |f| f[0][2] }.uniq == [[0, 160]] && a1.map { |f| f[0][3] }.uniq == [[16, 176]], [a1.first, a1.last].inspect
check "the reply: right side, the first speaker stays, dimmed", v2.side == :right && v2.entry == :pop && v2.rect == [384, 160, 128, 128] && v2.listener && v2.listener.id == :JUNO && v2.listener.side == :left, [v2.side, v2.rect, v2.listener && v2.listener.id].inspect
check "listener dims smoothly to the listener tone; speaker stays bright", a2.first[1][-2].between?(-41, 0) && a2.last[1][-2] == -42 && a2.all? { |f| f[0][-2] == 0 }, [a2.first, a2.last].inspect
check "nothing on the stage moves a pixel", a2.map { |f| f[0][2, 2] }.uniq == [[[384, 160], [400, 176]]] && a2.map { |f| f[1][2, 2] }.uniq == [[[0, 160], [16, 176]]], a2.map { |f| [f[0][2], f[1][2]] }.uniq.inspect
pbMessage("\\pf[JUNO,sad]Juno: You heard what happened.")
v3 = seen.last
a3 = trace.dup
trace.clear
check "back to the first speaker: her side, a cross-fade, no nudge", v3.side == :left && v3.entry == :swap && v3.listener.id == :KESTREL && File.basename(v3.file) == "JUNO_sad.png" &&
      a3.all? { |f| f[0][2] == [0, 160] && f[0][3] == [16, 176] } && a3.first[0].length == 7 && a3.first[0][-2].between?(-42, -1) && a3.last[0][-2] == 0, [v3.entry, a3.first, a3.last].inspect
pbMessage("Juno: (an untagged line keeps her face and Kestrel beside her)")
check "carried line: same faces, no entry", seen.last.entry == :none && seen.last.listener && seen.last.listener.id == :KESTREL, seen.last.entry
pbMessage("\\pf[LARCH,deadpan]Larch: A third voice.")
v4 = seen.last
check "third speaker takes the side of whoever spoke longest ago", v4.side == :right && v4.listener.id == :JUNO && X.stage.side_of(:KESTREL).nil?, [v4.side, v4.listener && v4.listener.id].inspect
pbMessage("(Narration: a pause.)")
pbMessage("\\pf[JUNO,sad]Juno: After a pause the stage starts again.")
check "after a gap: the speaker alone, on her own side", seen.last.side == :left && seen.last.listener.nil? && seen.last.entry == :pop, [seen.last.side, seen.last.entry].inspect
pbMessage("\\pfb[LARCH,angry,anger,1]Larch: A bubble is still 014's bubble.")
check "bubble lines are untouched", seen.last.is_a?(P::Bubble)
check "no sprite outlives its message box", P.current.nil? && $live == before, [$live, before].inspect
X.dual_stage = false
P.new_conversation
P.instance_variable_set(:@last_face, nil)
pf_say(:JUNO, :happy, "Stage off.")
check "dual_stage = false: 014's own face window", seen.last.instance_of?(P::FaceBox) && seen.last.entry == :pop, seen.last.class
X.dual_stage = true
$on_frame = nil

section "expressive conversations (018): balloons and overworld acting"
# The stub has no map classes, so give 018 a small Game_Character and load its hooks again.
class Game_Character
  attr_accessor :name, :x, :y, :direction, :character_name, :move_route_forcing, :walking, :transparent
  attr_reader :routes
  def initialize(name, x, y, dir = 2, charset = "NPC 01")
    @name = name; @x = x; @y = y; @direction = dir; @character_name = charset; @routes = 0
  end
  def screen_x; (@x * 32) + 16; end
  def screen_y; (@y * 32) + 32; end
  def moving?; @walking ? true : false; end
  def jumping?; false; end
  def update; end
  def force_move_route(route); @routes += 1; end
end
class Scene_Map
  def update; end
  def transfer_player(*args); end
  def disposeSpritesets(*args); end
end
def pbMapInterpreterRunning?; $interp_running ? true : false; end
old_verbose = $VERBOSE
$VERBOSE = nil
load File.join(PLUGIN_DIR, "018_ExpressiveDialogue.rb")
$VERBOSE = old_verbose
old_scene = $scene
old_map_events = $game_map.events
old_player = $game_player
juno = Game_Character.new("Juno (lab yard)", 5, 5)
kes = Game_Character.new("Kestrel K1", 7, 5, 4)
packets = Game_Character.new("Juno's seed packets", 1, 1)
brann = Game_Character.new("Brann", 5, 8)
$game_map.events = { 1 => juno, 2 => kes, 3 => packets, 4 => brann }
$game_player = Game_Character.new("player", 5, 7, 8)
$scene = Scene_Map.new
P.new_conversation
P.instance_variable_set(:@last_face, nil)
check "a name finds its event by prefix, not by possessive", X.resolve_character(:JUNO).equal?(juno) && X.resolve_character("Kestrel").equal?(kes) &&
      X.resolve_character(:PLAYER).equal?($game_player) && X.resolve_character(4).equal?(brann) && X.resolve_character(:NOBODY).nil?
4.times { |i| pbMessage("\\pf[#{i.even? ? 'JUNO,neutral' : 'KESTREL,angry'}]#{i.even? ? 'Juno' : 'Kestrel'}: line #{i}") }
check "no balloon unless a line asks for one", X.emotes_shown == 0 && X.emotes.count == 0
check "nobody is turned for the speaker by default", juno.direction == 2 && kes.direction == 4
shots = []
$on_frame = proc { shots.push(X.emotes.count) }
$msg_frames = 44                                   # 1.1 s at 40 fps: longer than a balloon
pbMessage("\\pf[KESTREL,sad]\\pfe[dots]Kestrel: ...Keep off the ridge tonight.")
$msg_frames = nil
$on_frame = nil
check "\\pfe[dots]: one balloon, over the speaker, gone inside a second", X.emotes_shown == 1 && shots.max == 1 && shots.last == 0 && $shown.last == "Kestrel: ...Keep off the ridge tonight.", [X.emotes_shown, shots.max, shots.last, $shown.last].inspect
b = pf_emote(:JUNO, :question)
check "balloon sits on the pixel grid over the head, on its row", b && b.sprite.x == juno.screen_x && b.sprite.y == juno.screen_y - 46 && b.sprite.src_rect.y == 2 * 32 && b.sprite.src_rect.x == 0, b && [b.sprite.x, b.sprite.y, b.sprite.src_rect.y].inspect
pbMessage("[name: Dock Hand] [emote: exclaim, Brann] Oi!")
check "[emote: kind, Target] on a plain line", X.emotes_shown == 3 && $shown.last == "[name: Dock Hand] Oi!", [X.emotes_shown, $shown.last].inspect
check "a fourth balloon in one conversation is dropped", pf_emote(:JUNO, :sweat).nil? && X.emotes_shown == 3 && pf_emote(:JUNO, :sweat, force: true) && pf_emote(:JUNO, :nope, force: true).nil?
X.clear_all
check "conversation over: balloons, viewport and sheet released", X.emotes.count == 0 && !X.active? && $live == before, [$live, before].inspect
P.new_conversation
pbMessage("\\pf[JUNO,happy]Juno: Facing you.")
check "automatic stance: a speaker facing the camera only", juno.pf_pose_sheet == "pose_JUNO" && juno.pf_pose_index == 0 && juno.pf_pose_auto, [juno.pf_pose_sheet, juno.pf_pose_index].inspect
pbMessage("\\pf[KESTREL,angry]Kestrel: Side on.")
check "...not one who is turned away from it", kes.pf_pose_sheet.nil?
juno.direction = 4
juno.update
check "turning drops an automatic stance", juno.pf_pose_sheet.nil?
pbMessage("\\pf[KESTREL,angry]\\pfp[crossed]\\pfa[step_back]Kestrel: Asked for.")
check "\\pfp[crossed]: the stance a line asks for", kes.pf_pose_sheet == "pose_KESTREL" && kes.pf_pose_index == 0 && !kes.pf_pose_auto, [kes.pf_pose_sheet, kes.pf_pose_index].inspect
$clock += 0.3
kes.update
off = [kes.pf_visual_ox, kes.pf_visual_oy]
check "\\pfa[step_back]: four pixels back from where he faces, held", off == [4, 0] && !kes.pf_acting?, off.inspect
pf_step_return(:KESTREL)
$clock += 0.3
kes.update
check "pf_step_return: back on his tile", [kes.pf_visual_ox, kes.pf_visual_oy] == [0, 0]
pf_nod(:JUNO)
$clock += 0.11
juno.update
mid = juno.pf_visual_oy
$clock += 0.2
juno.update
check "pf_nod: a two pixel dip and back", mid == 2 && juno.pf_visual_oy == 0, [mid, juno.pf_visual_oy].inspect
check "pf_pose on a four-row sheet uses the shared names", pf_pose(:BRANN, :brace) == true && brann.pf_pose_sheet == "pose_BRANN" && brann.pf_pose_index == 2 && pf_pose(:BRANN, :nonsense) == false
brann.walking = true
brann.update
check "walking off ends a stance", brann.pf_pose_sheet.nil?
brann.walking = false
check "pf_face_each_other turns two free characters", pf_face_each_other(:JUNO, :KESTREL) && juno.direction == 6 && kes.direction == 4
kes.force_move_route(nil)
kes.direction = 2
check "...but never one its event has walked into place", kes.pf_staged && kes.routes == 1 && pf_turn_toward(:KESTREL, :JUNO) == false && kes.direction == 2
X.auto_face = true
P.new_conversation
juno.direction = 2
brann.direction = 2
pbMessage("\\pf[JUNO,neutral]Juno: One.")
pbMessage("\\pf[BRANN,neutral]Brann: Two.")
check "auto_face (opt-in): speaker and last speaker turn to each other", juno.direction == 2 && brann.direction == 8 && !kes.pf_staged, [juno.direction, brann.direction].inspect
X.auto_face = false
$scene = old_scene
pbMessage("\\pf[JUNO,happy]\\pfe[exclaim]Juno: Off the map screen nothing acts.")
check "off the map: tags stripped, no balloon", $shown.last == "Juno: Off the map screen nothing acts." && X.emotes.count == 0
X.clear_all
P.new_conversation
$game_map.events = old_map_events
$game_player = old_player
$opt[:assets] = false
check "expressive lines leave nothing behind", $live == before && !X.active?, [$live, before].inspect

section "chapter opening cards (020)"
K = Prismfall::ChapterCards
check "ids: numbers, keys, names, slugs", K.resolve_key(5) == :CH05 && K.resolve_key(:PROLOGUE) == :CH00 && K.resolve_key("ch05_ten_years_of_light") == :CH05 &&
      K.resolve_key(:fallmorn) == :CH22 && K.resolve_key("ruin route") == :CH23 && K.resolve_key(99).nil? && K.resolve_key(:NOPE).nil?
check "V102 -> card: 0-21, post-game 23, none for the epilogue", K.key_for_chapter(0) == :CH00 && K.key_for_chapter(21) == :CH21 && K.key_for_chapter(22).nil? &&
      K.key_for_chapter(23) == :CH22 && K.key_for_chapter(nil).nil?
check "24 cards, each with the fields the player reads", K::CHAPTERS.length == 24 && K::CHAPTERS.values.all? { |c| c[:slug] && c[:num] && c[:title] && c[:act] && c[:location] && c[:cam].length == 6 && K::ParticleEmitter::COUNTS[c[:particle]] }
$opt[:assets] = true
missing = K::CHAPTERS.values.reject { |c| C::Gfx.resolve(K::ART_FOLDER + c[:slug]) }.map { |c| c[:slug] }
check "every card has its painting", missing.empty?, missing.inspect
$audio = []
r = run_scene(proc { K.play(:CH04) })
check "a card plays for lead + 6 s + lead and leaves nothing behind", r[:ok] == true && r[:leaks].empty? && r[:seconds].between?(6.5, 6.8), r.inspect
check "its chime is the installed SE, once", $audio.count { |a| a[0] == :se && a[1] == K::CHIME_SE } == 1 && $audio.none? { |a| a[0] == :me }, $audio.inspect
C.photosensitive = true
r = run_scene(proc { K.play(:CH16, duration: 3.0) })
C.photosensitive = false
check "photosensitive mode: plays, shorter duration honoured", r[:ok] == true && r[:leaks].empty? && r[:seconds].between?(3.5, 3.8), r.inspect
$input_trigger = proc { |b| b == Input::USE }
r = run_scene(proc { K.play(:CH23) })
r2 = run_scene(proc { K.play(:CH23, skippable: false) })
$input_trigger = nil
check "USE skips after 1.5 s (a short fade, not a cut)", r[:ok] == true && r[:leaks].empty? && r[:seconds].between?(2.4, 2.8), r.inspect
check "skippable: false plays through; the Ruin card has its own chime", r2[:seconds].between?(6.5, 6.8) && $audio.any? { |a| a[1] == K::RUIN_CHIME_SE }, [r2, $audio].inspect
$opt[:assets] = false
r = run_scene(proc { K.play(:CH01, duration: 2.5) })
check "no painting on disk: a plain backdrop, still no crash or leak", r[:ok] == true && r[:leaks].empty?, r.inspect
check "unknown chapter is a logged no-op", K.play(:CH99) == false
K.seen.clear
$msg_frames = nil
n = $stats[:frames]
a = pf_chapter_card(3, duration: 2.5)
b = pf_chapter_card(3, duration: 2.5)
f1 = $stats[:frames] - n
c = pf_chapter_card(3, force: true, duration: 2.5)
check "pf_chapter_card: once a save, again with force:", a == true && b == false && c == true && K.seen == [:CH03] && f1.between?(100, 140), [a, b, c, K.seen, f1].inspect
GameTempStub = Struct.new(:in_battle, :message_window_showing, :in_menu, :player_transferring)
old_temp = $game_temp
old_scene2 = $scene
old_plan = ENV.delete("DEMO_PLAN")
$game_temp = GameTempStub.new(false, false, false, false)
$scene = Scene_Map.new
$interp_running = true
n = $stats[:frames]
K.chapter_changed(7)
played = $stats[:frames] - n
K.chapter_changed(7)
check "V102 set by a map event: the card plays there, once", played > 200 && K.seen.include?(:CH07) && K.pending.nil? && $stats[:frames] - n == played, [played, K.seen].inspect
$game_temp.message_window_showing = true
K.chapter_changed(8)
check "set while a message is up: it waits", K.pending == :CH08 && !K.seen.include?(:CH08)
K.update_pending
$game_temp.message_window_showing = false
K.update_pending
check "...and while an event is still running", K.pending == :CH08
$interp_running = false
n = $stats[:frames]
K.update_pending
check "...then plays when the player is free on the map", K.pending.nil? && K.seen.include?(:CH08) && $stats[:frames] - n > 200
K.chapter_changed(22)
check "the epilogue (V102 = 22) has no card", K.pending.nil? && K.seen.length == 3, K.seen.inspect
ENV["DEMO_PLAN"] = "vault"
K.chapter_changed(9)
check "capture harness: no automatic card", K.pending.nil? && !K.seen.include?(:CH09) && !K.auto?
ENV.delete("DEMO_PLAN")
K.auto = false
K.chapter_changed(9)
check "ChapterCards.auto = false", K.pending.nil? && !K.seen.include?(:CH09)
K.auto = nil
ENV["DEMO_PLAN"] = old_plan if old_plan
$game_temp = old_temp
$scene = old_scene2
K.seen.clear
check "cards leave nothing behind", $live == before, [$live, before].inspect

section "debug menu"
h = MenuHandlers::HANDLERS[:debug_menu] || {}
ids = [:prismfall_cutscenes_menu, :prismfall_cutscenes_war, :prismfall_cutscenes_war_demo, :prismfall_cutscenes_highlight,
       :prismfall_cutscenes_highlight_auto, :prismfall_cutscenes_any, :prismfall_cutscenes_portraits]
check "entries registered", ids.all? { |i| h[i] && h[i]["name"] && h[i]["parent"] }, (ids - h.keys).inspect
$msg_frames = 2
$menu_choice = 1
ids[1..-1].each do |i|
  $menu_choice = (i == :prismfall_cutscenes_any) ? C.ids.index(:NOSKIP) : 1
  r = (h[i]["effect"].call; true) rescue $!
  check "debug effect #{i}", r == true, r.inspect
end

section "live-map scene registry (016) and the AdvancedAnimations engine (017)"
aa = Prismfall::AdvancedAnimations
check "engine loaded, cut plates prepended", defined?(aa::Engine) && aa::Engine.ancestors.include?(aa::CutPlateExtension)
check "the movie path is gone", !C.respond_to?(:movie) && !C.respond_to?(:movie_file)
bad = C::SCENES.reject { |_, i| aa.respond_to?(i[:play]) }.keys
check "every registered scene has its play method", bad.empty?, bad.inspect
names = C::SCENES.keys + C::SCENES.values.flat_map { |i| i[:aliases] }
check "scene ids and aliases are unique", names.uniq.length == names.length, names.group_by { |n| n }.select { |_, v| v.length > 1 }.keys.inspect
check "aliases resolve", C.scene_key(:IR1) == :CH9_UNMASK && C.scene_key("war1") == :WAR_CLIMAX && C.scene_key(:SH1_DC) == :CH5_DC && C.scene_key(:CE1) == :CH15_GLASSFALL
check "unknown id is a logged no-op", pfm_cutscene(:NO_SUCH_SCENE) == false && C.scene_log.last.include?("no such scene"), C.scene_log.last
r = [:CH9_UNMASK, :CH21_ARCEUS, :RUIN_R7_AURELIUS, :CH2_PAGEANT, :SH1].map { |i| (pfm_cutscene(i) rescue $!) }
check "a scene that can't play here returns false, never raises", r.all? { |v| v == false }, r.inspect
check "SH1_BURN is a no-op that succeeds", pfm_cutscene(:SH1_BURN) == true
check "pbRejuvCutscene: unknown id is nil", pbRejuvCutscene(:NO_SUCH_SCENE).nil?
check "audio tags map to Prismfall's files", C.scene_bgm("ch9_tension") == "Mood - Tension" && C.scene_se("ch16_gunshot") == "Directorate Rifle Crack" && C.scene_se("Exclaim") == "Exclaim"
$opt[:audio] = false
check "a tag with no file is silent and listed", C.scene_bgm("ruin_cosmic_air").nil? && C.missing_audio.include?("BGM/ruin_cosmic_air"), C.missing_audio.inspect
$opt[:audio] = nil
check "captures stay inside the game folder", aa.safe_capture_dir("/tmp/x").nil? && aa.safe_capture_dir("../x").nil? && aa.safe_capture_dir("Captures/x") == "Captures/x"
src017 = File.read(File.join(PLUGIN_DIR, "017_AdvancedAnimations.rb"))
check "the Gilded King is AURELIUS in the scene code", !src017.include?("THEODRIC") && src017.include?('eng.say(:AURELIUS, :neutral, "Know your place, mongrel."')

puts
puts "#{$checks} checks, #{$fails.length} failed. Frames simulated: #{$stats[:frames]}, fill_rects: #{$stats[:fill]}, sprites: #{$stats[:sprites]}, bitmaps: #{$stats[:bitmaps]}"
puts "Live objects at exit: #{$live.inspect} (bitmaps = cached placeholder charsets)"
exit(($fails.empty?) ? 0 : 1)
